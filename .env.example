# Datenbank
DB_PASSWORD=changeme_in_production

# JWT Secret - bitte mit `openssl rand -hex 32` neu erzeugen!
SECRET_KEY=please_change_this_secret_key_to_something_random

# Bambu Lab Cloud Account (optional - für Cloud-Modus)
BAMBU_CLOUD_EMAIL=
BAMBU_CLOUD_PASSWORD=

# Tuya Cloud API (für Stromverbrauchsdaten)
# Diese Daten findest du im Tuya IoT Platform Dashboard:
# 1. Konto erstellen auf https://iot.tuya.com
# 2. Cloud Project anlegen
# 3. Access ID + Access Secret kopieren
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Region: openapi.tuyaeu.com (EU), openapi.tuyaus.com (US), openapi.tuyacn.com (CN)
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com
